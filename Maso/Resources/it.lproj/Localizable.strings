"vs %@" = "vs %@";
"variant.high" = "Ancora più alta — l'estrazione proviene dall'alto, biasing tratti posteriori e posteriore superiore rispetto all'altezza standard.";
"variant.low" = "Ancoraggio più basso — guida verso l'alto biases il torace superiore e i punti anteriore vs l'altezza standard.";
"variant.mid" = "Ancoraggio medio-altezza — una linea di tiro bilanciata, più vicina all'enfasi del movimento di base.";
"variant.incline" = "Angolo inclinato — sposta l'accento sul petto superiore e sul lato anteriore.";
"variant.decline" = "L'angolo sgonfiato — sposta l'enfasi sul petto inferiore, o allunga la gamma di abs in mosse di nucleo.";
"variant.seated" = "Seduto — rimuove l'azionamento della gamba e lo slancio per un isolamento più rigoroso del muscolo bersaglio.";
"variant.standing" = "In piedi — aggiunge il coinvolgimento del core e dello stabilizzatore rispetto alla versione supportata.";
"variant.lying" = "Ling — elimina lo stress momentum e ribasso, isolando il movimento principale.";
"variant.kneeling" = "Ginocchiera — blocca l'azionamento della gamba e richiede maggiore stabilità del nucleo.";
"variant.prone" = "Prone (face-down) — il pad rimuove il tradimento per il ristretto e il lavoro superiore.";
"variant.supine" = "Supina (face-up) — stabilizza la colonna vertebrale e isola il primo movimento.";
"variant.single-arm" = "Un braccio alla volta — fissa gli squilibri di sinistra/destra e aggiunge il lavoro di nucleo anti-rotazione.";
"variant.single-leg" = "Una gamba alla volta — fissa gli squilibri e richiede più stabilità glute-medius.";
"variant.alternating" = "Lati alternativi — tempo più lungo sotto tensione con un micro-resto incorporato ogni ripetitore.";
"variant.wide-grip" = "Impugnatura del tergicristallo — gamma più corta di movimento, larghezza del lat biasing e il petto esterno.";
"variant.close-grip" = "Aderenza più stretta — gamma più lunga di movimento, biasing i tricipiti e petto interno.";
"variant.neutral-grip" = "Palme di fronte — un angolo di spalla-friendly che biasima la brachialis e avambracci su tira.";
"variant.reverse-grip" = "Impugnatura rovesciata — enfasi sposta: più bicipiti su tira, più torace superiore su presse.";
"variant.underhand" = "Impugnatura a mano — più bicipiti e più basso coinvolgimento che in eccesso.";
"variant.overhand" = "Impugnatura eccessiva — maggiore coinvolgimento dell'avambraccio e della parte superiore rispetto al sottomano.";
"variant.paused" = "Pausa in fondo — rimuove il riflesso elastico e costruisce la forza dal foro.";
"variant.deficit" = "Installazione elevata/deficit — estende la gamma di movimento per un tratto più profondo.";
"variant.weighted" = "Carico aggiunto — lo stesso movimento ad alta intensità per progressione di forza.";
"variant.assisted" = "L'assistenza compensa il peso corporeo — lo stesso modello ad una intensità più semplice.";
"variant.sumo" = "Ampia posizione di sumo — più adduttore e il coinvolgimento gluteo con minore stress di ritorno.";
"variant.romanian" = "Giri indietro, ginocchia morbide — mantiene la tensione sulle corde attraverso il tratto.";
"variant.bulgarian" = "Piede posteriore elevato — carico a singola gamba con un gluteo profondo e quad stretch.";
"variant.goblet" = "Carico tenuto al petto — mantiene il torso dritto, rendendo la profondità e la forma più facile.";
"variant.front" = "Caricare davanti — un torso più verticale biasima i quad e la parte posteriore superiore.";
"variant.overhead" = "Sovraccarico del carico — aggiunge la stabilità della spalla e la domanda principale al movimento di base.";
"variant.walking" = "Versione di viaggio — aggiunge domanda di equilibrio e tensione continua vs in-place.";
"variant.reverse" = "La direzione inversa — sposta l'accento sulla parte opposta del modello.";
"variant.lateral" = "Aeroplano lateralmente — biasima i rapitori e i delt laterali contro la versione retta.";
"variant.tuck" = "Ginocchiera bloccata — accorcia la leva; una progressione più facile del movimento completo.";
"variant.floor" = "Dal pavimento — gamma ridotta protegge le spalle e rimuove l'azionamento della gamba.";
"variant.chest-supported" = "Petto sul cuscinetto — zero slancio, rigido isolamento superiore.";
"variant.bent-over" = "Hinged torso — aggiunge il coinvolgimento in basso-indietro e hamstring; mantenere una stretta cerniera.";
"variant.dead-stop" = "Intero stop ogni ripetitore — elimina il rimbalzo e costruisce la forza di partenza.";
"variant.split" = "Dividere la posizione — biasima una gamba alla volta con una domanda di equilibrio aggiuntiva.";
"variant.hammer" = "Impugnatura del martello neutro — biasima la brachialis e gli avambracci.";
