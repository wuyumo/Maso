"variant.low" = "Ancla inferior: conducir sesgos hacia arriba el pecho superior y los dedos delanteros frente a la altura estándar.";
"variant.mid" = "Anclaje de altura media — una línea equilibrada de atracción, más cercana al énfasis del movimiento base.";
"variant.incline" = "Ángulo inclinado — cambia el énfasis a los puntos del pecho superior y del frente.";
"variant.decline" = "Ángulo declinado: cambia el énfasis al pecho inferior, o alarga el rango de los abdominales en los movimientos del núcleo.";
"variant.seated" = "El asiento — elimina el impulso de la pierna y el impulso para un aislamiento más estricto del músculo objetivo.";
"variant.standing" = "Standing — añade la participación de núcleo y estabilizador en comparación con la versión soportada.";
"variant.lying" = "Mentir — elimina el impulso y el estrés más bajo, aislando al impulsor principal.";
"variant.kneeling" = "Pulsar — bloquea la unidad de la pierna y exige más estabilidad del núcleo.";
"variant.prone" = "Prone (cara abajo) — la almohadilla elimina el engaño para el trabajo de retaguardia estricto y de retaguardia.";
"variant.supine" = "Supine (face-up) — estabiliza la columna y aísla al motor principal.";
"variant.single-arm" = "Un brazo a la vez — fija los desequilibrios izquierdo/derecho y añade el trabajo básico anti-rotación.";
"variant.single-leg" = "Una pierna a la vez — fija los desequilibrios y exige más estabilidad de glute-medius.";
"variant.alternating" = "Lados alternantes — tiempo más largo bajo tensión con un micro-resto incorporado cada rep.";
"variant.wide-grip" = "Agarre más ancho — rango más corto de movimiento, ancho de lat sesgado y el pecho exterior.";
"variant.close-grip" = "Agarre más estrecho: mayor rango de movimiento, sesgado los tríceps y el pecho interior.";
"variant.neutral-grip" = "Las palmas orientadas — un ángulo de hombro que sesgada las brachialis y antebrazos en tiradas.";
"variant.reverse-grip" = "Empuñadura inversa — cambia el énfasis: más biceps en tiras, más pecho superior en las prensas.";
"variant.underhand" = "Agarre bajo la mano — más bíceps y menor implicación que demasiado.";
"variant.overhand" = "Agarre de sobremano — más forraje y participación de arriba hacia atrás que bajo la mano.";
"variant.paused" = "La pausa en la parte inferior — elimina el reflejo del estiramiento y construye la fuerza fuera del agujero.";
"variant.deficit" = "Configuración elevada/deficit: amplía la gama de movimiento para un tramo más profundo.";
"variant.weighted" = "Carga agregada: el mismo movimiento a mayor intensidad para la progresión de la fuerza.";
"variant.assisted" = "La asistencia compensa el peso corporal, el mismo patrón a una intensidad más fácil.";
"variant.sumo" = "Posición de sumo ancha — más aductor y glute implicación con menor estrés de espalda.";
"variant.romanian" = "Caderas hacia atrás, rodillas suaves — mantiene la tensión en las hamstrings a través del estiramiento.";
"variant.bulgarian" = "Pie trasero elevado — carga de una sola pierna con un glúteo profundo y estiramiento en quad.";
"variant.goblet" = "La carga se mantiene en el pecho — mantiene el torso recto, facilitando la profundidad y la forma.";
"variant.front" = "Carga en frente - un torso más vertical sesgada los quads y la parte superior de la espalda.";
"variant.overhead" = "Cargar por encima — añade estabilidad del hombro y demanda básica al movimiento base.";
"variant.walking" = "Versión itinerante — añade demanda de equilibrio y tensión continua vs en el lugar.";
"variant.reverse" = "Dirección inversa - cambia el énfasis a la porción opuesta del patrón.";
"variant.lateral" = "Plano lateral - sesgosa a los secuestradores y los delts laterales frente a la versión recta.";
"variant.tuck" = "Las rodillas sintonizadas — acorta la palanca; una progresión más fácil del movimiento completo.";
"variant.floor" = "Desde el suelo — rango reducido protege los hombros y elimina la unidad de la pierna.";
"variant.chest-supported" = "El tórax en la almohadilla: cero impulso, estricto aislamiento superior.";
"variant.bent-over" = "El torso anillado — añade una participación más baja y de hamacas; mantiene una bisagra estricta.";
"variant.dead-stop" = "Parada completa de cada rep — elimina el rebote y construye la fuerza inicial.";
"variant.split" = "Estancia dividida: sesgos una pierna a la vez con una demanda de equilibrio adicional.";
"variant.hammer" = "Agarre de martillo neutro - sesgosa las brachialis y antebrazos.";
