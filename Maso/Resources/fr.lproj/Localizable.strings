"vs %@" = "vs %@";
"variant.high" = "Ancre plus élevée — la traction vient du haut, biaisant les delts arrière et le haut du dos par rapport à la hauteur standard.";
"variant.low" = "L'ancre inférieure — la conduite vers le haut biaise la poitrine supérieure et les delts avant par rapport à la hauteur standard.";
"variant.mid" = "Ancre de taille moyenne — une ligne de traction équilibrée, la plus proche de l'accent du mouvement de base.";
"variant.incline" = "Angle incliné — déplace l'accent vers la poitrine supérieure et les delts avant.";
"variant.decline" = "Angle décliné — déplace l'accent vers le bas de la poitrine, ou allonge la portée des abdominaux dans les mouvements de cœur.";
"variant.seated" = "Assis — élimine l'entraînement des jambes et l'élan pour un isolement plus strict du muscle cible.";
"variant.standing" = "Standing — ajoute l'implication du noyau et du stabilisateur par rapport à la version supportée.";
"variant.lying" = "Allongement — élimine l'élan et le stress inférieur, isolant le moteur principal.";
"variant.kneeling" = "Le genou — verrouille l'entraînement des jambes et exige plus de stabilité centrale.";
"variant.prone" = "Prone (face vers le bas) — le tampon élimine la tricherie pour un travail strict à l'arrière et au dos.";
"variant.supine" = "Supine (face vers le haut) – stabilise la colonne vertébrale et isole le mouvement principal.";
"variant.single-arm" = "Un bras à la fois — corrige les déséquilibres gauche/droite et ajoute le travail de base anti-rotation.";
"variant.single-leg" = "Une étape à la fois — corriger les déséquilibres et exiger plus de stabilité glute-médiée.";
"variant.alternating" = "Des côtés alternants — plus de temps sous tension avec un micro-siège intégré chaque rep.";
"variant.wide-grip" = "Poignée plus large — portée plus courte du mouvement, largeur de la latte biaisée et la poitrine extérieure.";
"variant.close-grip" = "Une prise en main plus étroite — une plus grande plage de mouvement, en biaisant les triceps et la poitrine intérieure.";
"variant.neutral-grip" = "Face aux palmiers — un angle favorable aux épaules qui biaise les brachiaux et les avant-bras sur les tractions.";
"variant.reverse-grip" = "Poignée inversée — déplacement de l'accent: plus de biceps sur les tractions, plus de poitrine supérieure sur les presses.";
"variant.underhand" = "Poignée sous la main — plus de biceps et d'implication plus faible que l'overhand.";
"variant.overhand" = "Poignée supérieure — plus d'avant-bras et d'implication dans le dos supérieur que sous-main.";
"variant.paused" = "Pause au fond — enlève le réflexe d'étirement et construit la force hors du trou.";
"variant.deficit" = "Configuration élevée/déficit — étend la portée du mouvement pour un étirement plus profond.";
"variant.weighted" = "Ajout de la charge — le même mouvement à plus grande intensité pour la progression de la résistance.";
"variant.assisted" = "L'aide compense le poids corporel — le même schéma à une intensité plus facile.";
"variant.sumo" = "Grande position du sumo — plus d'adducteur et d'implication de glissade avec moins de stress au dos.";
"variant.romanian" = "Reculez les hanches, les genoux mous — gardez la tension sur les cordes à travers l'étirement.";
"variant.bulgarian" = "Pied arrière surélevé — chargement à une seule jambe avec un gliute profond et quad stretch.";
"variant.goblet" = "Charge maintenue à la poitrine — maintient le torse debout, ce qui facilite la profondeur et la formation.";
"variant.front" = "Charger devant — un torse plus droit biaise les quads et le haut du dos.";
"variant.overhead" = "Charger au-dessus — ajoute la stabilité de l'épaule et la demande de base au mouvement de base.";
"variant.walking" = "Version itinérante — ajoute la demande d'équilibre et la tension continue par rapport à la place.";
"variant.reverse" = "Direction inversée — déplace l'accent vers la partie opposée du modèle.";
"variant.lateral" = "Plan latéral — biaise les abducteurs et les delts latéraux par rapport à la version droite.";
"variant.tuck" = "Genoux cousus — raccourcit le levier; une progression plus facile du mouvement complet.";
"variant.floor" = "Du sol — une portée réduite protège les épaules et enlève l'entraînement des jambes.";
"variant.chest-supported" = "Poitrine sur le pad — pas d'élan, isolement strict du haut du dos.";
"variant.bent-over" = "Le torse à charnières — ajoute une intervention au dos inférieur et à la corde; gardez une charnière stricte.";
"variant.dead-stop" = "Arrêt complet de chaque rep – élimine le rebond et construit la force de départ.";
"variant.split" = "Diviser la position — biaise une jambe à la fois avec une demande d'équilibre supplémentaire.";
"variant.hammer" = "Poignée de marteau neutre — biaise les brachiaux et les avant-bras.";
