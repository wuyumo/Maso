"Variant" = "Variante";
"vs %@" = "vs %@";
"variant.high" = "Ancoração superior — a tração vem de cima, inclinando os delts traseiros e as costas superiores contra a altura padrão.";
"variant.low" = "Ancoração inferior — direcionando para cima vieses do peito superior e delts frontais vs a altura padrão.";
"variant.mid" = "Ancoração de altura média — uma linha de tração equilibrada, mais próxima da ênfase do movimento de base.";
"variant.incline" = "Ângulo inclinado — desloca a ênfase para o peito superior e delts frontais.";
"variant.decline" = "Ângulo declinado — desloca a ênfase para o peito inferior, ou alonga o alcance do abs em movimentos de núcleo.";
"variant.seated" = "Sentado — remove o impulso da perna e o impulso para um isolamento mais rigoroso do músculo alvo.";
"variant.standing" = "Em pé — adiciona envolvimento de núcleo e estabilizador em comparação com a versão suportada.";
"variant.lying" = "Mentir — elimina o impulso e o stress lombar, isolando o primeiro movimento.";
"variant.kneeling" = "Ajoelha - bloqueia a movimentação da perna e exige mais estabilidade do núcleo.";
"variant.prone" = "Prone (face-down) — a almofada remove a batota para o trabalho rígido traseiro e superior-back.";
"variant.supine" = "Supina (face-up) — estabiliza a coluna vertebral e isola o primeiro movedor.";
"variant.single-arm" = "Um braço de cada vez — corrige desequilíbrios esquerda/direita e adiciona o trabalho de núcleo anti-rotação.";
"variant.single-leg" = "Uma perna de cada vez — corrige desequilíbrios e exige mais estabilidade glútea-medium.";
"variant.alternating" = "Lados alternantes — tempo mais longo sob tensão com um micro-repouso incorporado cada rep.";
"variant.wide-grip" = "Maior aderência – menor amplitude de movimento, largura da lat tendenciosa e o tórax externo.";
"variant.close-grip" = "Aperto mais próximo – maior amplitude de movimento, tendenciosa o tríceps e peito interno.";
"variant.neutral-grip" = "As palmas voltadas para o ombro — um ângulo favorável ao ombro que tende a braquialis e antebraços em puxar.";
"variant.reverse-grip" = "Aperto reverso — ênfase de deslocamentos: mais bíceps em puxamentos, mais peito superior em prensas.";
"variant.underhand" = "Embraiagem por baixo da mão — mais envolvimento bíceps e inferior-lat do que sobremão.";
"variant.overhand" = "Aperto superior — mais envolvimento do antebraço e do dorso superior do que em baixo.";
"variant.paused" = "Pausa no fundo — remove o reflexo de estiramento e constrói força para fora do buraco.";
"variant.deficit" = "Configuração elevada/deficiência — amplia a amplitude de movimento para uma extensão mais profunda.";
"variant.weighted" = "Carga adicionada — o mesmo movimento com maior intensidade para a progressão da força.";
"variant.assisted" = "A assistência compensa o peso corporal — o mesmo padrão numa intensidade mais fácil.";
"variant.sumo" = "Ampla postura sumô — mais envolvimento adutor e glúteo com menos estresse lombar.";
"variant.romanian" = "Ancas para trás, joelhos macios — mantém tensão nos isquiotibiais através do estiramento.";
"variant.bulgarian" = "Pé traseiro elevado - carga de uma perna com um glúteo profundo e quad estiramento.";
"variant.goblet" = "Carga mantida no peito — mantém o tronco ereto, tornando a profundidade e forma mais fácil.";
"variant.front" = "Carregar na frente — um tronco mais ereto tende a parcializar os quadris e a parte superior das costas.";
"variant.overhead" = "A sobrecarga de carga – adiciona a estabilidade do ombro e a demanda do núcleo ao movimento de base.";
"variant.walking" = "Versão de viagem — adiciona demanda de equilíbrio e tensão contínua vs in-place.";
"variant.reverse" = "Direção inversa — desloca a ênfase para a parte oposta do padrão.";
"variant.lateral" = "Plano lateral — vieses os abdutores e delts laterais vs a versão reta.";
"variant.tuck" = "Joelhos dobrados — encurta a alavanca; uma progressão mais fácil do movimento completo.";
"variant.floor" = "Do chão — o alcance reduzido protege os ombros e remove a movimentação das pernas.";
"variant.chest-supported" = "Peito sobre a almofada — momento zero, rigoroso isolamento das costas superiores.";
"variant.bent-over" = "Torso dobrado — adiciona envolvimento das costas inferiores e isquiotibiais; mantenha uma dobradiça rígida.";
"variant.dead-stop" = "Pare completamente cada representante — elimina o salto e constrói a força inicial.";
"variant.split" = "Posição dividida — parcializa uma perna de cada vez com uma demanda de saldo adicional.";
"variant.hammer" = "Garra de martelo neutra — vieses o braquial e antebraços.";
