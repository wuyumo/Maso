"variant.standing" = "Stehen — fügt Kern und Stabilisator Beteiligung im Vergleich zu der unterstützten Version.";
"variant.lying" = "Liegen - beseitigt Momentum und Rückenbelastung und isoliert den Hauptantrieb.";
"variant.kneeling" = "Knien - sperrt Beinantrieb aus und fordert mehr Kernstabilität.";
"variant.prone" = "Prone (gesicht nach unten) - das pad entfernt betrug für strenge heck-delt und upper-back-arbeit.";
"variant.supine" = "Supine (face-up) - stabilisiert die Wirbelsäule und isoliert den Hauptantrieb.";
"variant.single-arm" = "Ein Arm nach dem anderen - behebt linke / rechte Ungleichgewichte und fügt Kernarbeit gegen Rotation hinzu.";
"variant.single-leg" = "Ein Bein nach dem anderen - behebt Ungleichgewichte und fordert mehr Gesäß-Medius-Stabilität.";
"variant.alternating" = "Abwechselnde Seiten - längere Zeit unter Spannung mit einer eingebauten Mikro-Ruhe jede Wiederholung.";
"variant.wide-grip" = "Breiterer Griff — kürzerer Bewegungsbereich, vorspannende Breite und äußere Brust.";
"variant.close-grip" = "Engerer Griff - längerer Bewegungsbereich, vorspannend für den Trizeps und die innere Brust.";
"variant.neutral-grip" = "Palmen nach vorne - ein schulterfreundlicher Winkel, der die Brachialis und Unterarme auf Ziehen vorspannt.";
"variant.reverse-grip" = "Reversed Grip - verschiebt die Betonung: mehr Bizeps auf Ziehen, mehr obere Brust auf Pressen.";
"variant.underhand" = "Unterhand Grip - mehr Bizeps und niedriger-lat Beteiligung als Overhand.";
"variant.overhand" = "Overhand Grip - mehr Unterarm und oberen Rücken Beteiligung als Unterhand.";
"variant.paused" = "Pause an der Unterseite - entfernt den Dehnreflex und baut Stärke aus dem Loch auf.";
"variant.deficit" = "Erhöhte / Defizit-Setup - erweitert den Bewegungsbereich für eine tiefere Dehnung.";
"variant.weighted" = "Zusätzliche Last - die gleiche Bewegung bei höherer Intensität für den Kraftverlauf.";
"variant.assisted" = "Die Hilfe gleicht das Körpergewicht aus - das gleiche Muster mit einer leichteren Intensität.";
"variant.sumo" = "Breite Sumo-Haltung - mehr Adduktor und Gesäßbeteiligung mit weniger Rückenbelastung.";
"variant.romanian" = "Hüften zurück, weiche Knie — hält Spannung auf den Kniebeugen durch die Strecke.";
"variant.bulgarian" = "Hinterer Fuß erhöht — einbeinige Belastung mit tiefer Gesäß- und Vierbeindehnung.";
"variant.goblet" = "Last an der Brust gehalten - hält den Rumpf aufrecht und macht Tiefe und Form leichter.";
"variant.front" = "Laden Sie vorne - ein aufrechterer Rumpf vorspannt die Quads und den oberen Rücken.";
"variant.overhead" = "Load Overhead - fügt der Basisbewegung Schulterstabilität und Kernnachfrage hinzu.";
"variant.walking" = "Reiseversion - fügt die Balance-Nachfrage und kontinuierliche Spannung gegenüber dem Ort hinzu.";
"variant.reverse" = "Umkehrende Richtung - verschiebt die Betonung auf den gegenüberliegenden Teil des Musters.";
"variant.lateral" = "Seitwärtsebene - verzerrt die Entführer und Seitendelten gegenüber der geraden Version.";
"variant.tuck" = "Knie versteckt — verkürzt den Hebel; eine leichtere Progression der vollen Bewegung.";
"variant.floor" = "Vom Boden — reduzierte Reichweite schützt die Schultern und entfernt Beinantrieb.";
"variant.chest-supported" = "Brust auf dem Pad - Null Momentum, strenge Isolation des oberen Rückens.";
"variant.bent-over" = "Hinged torso — fügt unteren Rücken und Kniesehne Beteiligung; halten Sie ein strenges Scharnier.";
"variant.dead-stop" = "Full Stop jede Wiederholung - eliminiert den Bounce und baut Startstärke auf.";
"variant.split" = "Split-Haltung - verzerrt ein Bein nach dem anderen mit einer zusätzlichen Balance-Nachfrage.";
"variant.hammer" = "Neutraler Hammergriff — verzerrt die Brachialis und Unterarme.";
