"Saved AI results" = "Gespeicherte KI-Ergebnisse";
"No saved AI results yet." = "Noch keine KI-Ergebnisse gespeichert.";
"Saved AI result" = "Gespeichertes KI-Ergebnis";
"Monthly text tasks used: %d of 2" = "Textaufgaben diesen Monat: %d von 2";
"Copy message" = "Nachricht kopieren";
"Edit and resend" = "Bearbeiten und erneut senden";
"Editing text only. Sending adds a new message; your previous draft is kept." = "Nur Text bearbeiten. Senden fügt eine neue Nachricht hinzu; dein bisheriger Entwurf bleibt erhalten.";
"Cancel edit" = "Bearbeitung abbrechen";
"This AI task needs Pro. Your saved results remain available." = "Diese KI-Aufgabe benötigt Pro. Gespeicherte Ergebnisse bleiben verfügbar.";
"Make room in My Plans before generating. Existing plans and training history are not deleted." = "Schaffe vor dem Generieren Platz in Meine Pläne. Bestehende Pläne und Trainingsdaten werden nicht gelöscht.";
"This AI task is already running. Please wait." = "Diese KI-Aufgabe läuft bereits. Bitte warten.";
"Review AI access on this device before continuing." = "Prüfe zuerst den KI-Zugang auf diesem Gerät.";
"AI access could not be saved on this device. Nothing was charged." = "Der KI-Verbrauch konnte nicht gespeichert werden. Es wurde nichts abgezogen.";
"Today's automatic AI recommendation is already available." = "Die automatische KI-Empfehlung für heute ist bereits verfügbar.";

